# ==============================================================================
# SyntaxOps Studio - AWS Lambda & S3 Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development, and configure
# these environment variables in your Vercel Project Settings for production.

# 1. AWS Credentials (IAM User or Role)
# Requires permissions for AWS Lambda (invoke, list) and S3 (read, write, presign).
REMOTION_AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
REMOTION_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
REMOTION_AWS_REGION=us-east-1

# 2. S3 Bucket
# The bucket where uploaded source videos are stored and where rendered MP4s will be saved.
# Automatically set or created when deploying with Remotion Lambda CLI.
REMOTION_BUCKET_NAME=your-remotion-lambda-bucket-name

# 3. Remotion Lambda Deployed Function
# The function deployed via: npx remotion lambda functions deploy --memory=3008 --disk=2048 --timeout=120
REMOTION_FUNCTION_NAME=remotion-render-4-0-543-mem3008mb-disk2048mb-120sec

# 4. Remotion Lambda Deployed Site Bundle URL
# The S3 site URL deployed via: npx remotion lambda sites create src/index.ts --site-name=syntax-ops-site
REMOTION_SERVE_URL=https://your-remotion-lambda-bucket-name.s3.us-east-1.amazonaws.com/sites/syntax-ops-site/index.html

# ==============================================================================
# 5. SyntaxOps Studio - Single-User Authentication
# ==============================================================================
# Authorized email address for studio login
STUDIO_LOGIN_EMAIL=mail-favour@gmail.com

# Studio login password (matches your entered password directly)
# You can set either STUDIO_LOGIN_PASSWORD or STUDIO_LOGIN_PASSWORD_HASH
STUDIO_LOGIN_PASSWORD=your_password_here

# (Optional) Secret for session cookies. Automatically falls back if not set.
STUDIO_SESSION_SECRET=your_session_secret_here

